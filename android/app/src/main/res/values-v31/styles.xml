<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows its own system splash (launcher icon on a background). Keep it cream.
         windowBackground is repeated from values/styles.xml because this style replaces that one on API 31+. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_cream</item>
    </style>
</resources>
